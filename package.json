{
  "name": "ephemeral-vm-mcp",
  "version": "0.1.0",
  "description": "MCP server that provisions ephemeral LXC containers on Proxmox pve2",
  "type": "module",
  "bin": {
    "ephemeral-vm-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "typecheck": "tsc --noEmit",
    "check:proxmox": "tsx scripts/check-proxmox.ts",
    "smoke": "tsx scripts/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ssh2": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
