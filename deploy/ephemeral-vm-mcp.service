# /etc/systemd/system/ephemeral-vm-mcp.service
# Runs the MCP server with the streamable-HTTP transport on 127.0.0.1:8788 and
# the web dashboard on 127.0.0.1:8789 (both localhost only, one process). The
# Cloudflare tunnel is the sole external ingress for both.
#
# Dashboard env (DASHBOARD_SESSION_SECRET etc.) goes in the same .env file;
# set DASHBOARD_ENABLED=0 there to run the MCP transport without the dashboard.
#
#   cp deploy/ephemeral-vm-mcp.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now ephemeral-vm-mcp

[Unit]
Description=Ephemeral VM MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ephemeral-vm-mcp
EnvironmentFile=/opt/ephemeral-vm-mcp/.env
ExecStart=/usr/bin/node /opt/ephemeral-vm-mcp/dist/index.js --http
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/ephemeral-vm-mcp/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
