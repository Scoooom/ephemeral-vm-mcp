# App environment for ephemeral-vm-mcp.
# Proxmox API credentials are NOT here — they live in /opt/.proxmox-api-info
# (dotenv: PROXMOX_HOST, PROXMOX_TOKEN_ID, PROXMOX_TOKEN_SECRET).

# --- Proxmox target -------------------------------------------------------
PROXMOX_NODE=pve2
PROXMOX_STORAGE=media
PROXMOX_TEMPLATE_ID=113
# resource pool every ephemeral CT is placed in; created if missing. Empty = no pool.
EPHEMERAL_POOL=ephemeral

# --- Ephemeral network (vmbr2 / 10.10.30.0/24) --------------------------
EPHEMERAL_BRIDGE=vmbr2
EPHEMERAL_SUBNET=10.10.30.0
EPHEMERAL_GATEWAY=10.10.30.1
EPHEMERAL_CIDR_BITS=24
EPHEMERAL_RANGE_START=10
EPHEMERAL_RANGE_END=254
# comma-separated last-octets never to allocate (gateway, template, this host)
EPHEMERAL_RESERVED=1,113,115

# --- SSH into ephemeral containers -------------------------------------
SSH_USER=root
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# --- run_claude_task --------------------------------------------------
CLAUDE_DEFAULT_MAX_TURNS=12

# --- Local DB ---------------------------------------------------------
MCP_DB_PATH=./data/ephemeral.db

# --- HTTP transport (only used with --http) --------------------------
MCP_HTTP_PORT=8788
MCP_HTTP_HOST=127.0.0.1
# Bearer token clients must present as `Authorization: Bearer <token>`
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# --- Web dashboard (only started with --http) ------------------------
# Served on localhost; the Cloudflare tunnel (proxweb.scooom.com) is the ingress.
DASHBOARD_ENABLED=1
DASHBOARD_PORT=8789
DASHBOARD_HOST=127.0.0.1
# WebAuthn: must match the public hostname the browser connects to.
DASHBOARD_RP_ID=proxweb.scooom.com
DASHBOARD_ORIGIN=https://proxweb.scooom.com
# HMAC key for session cookies. Required when the dashboard is enabled.
DASHBOARD_SESSION_SECRET=change-me-to-another-long-random-string
# Recommended: require this token to register the FIRST passkey, so a stranger
# who reaches the URL first cannot enroll themselves. Unset = trust-on-first-use.
DASHBOARD_ENROLL_TOKEN=change-me-or-leave-unset
